APP_ENV=production
APP_VERSION=3.0.0
BUILD_COMMIT=replace-with-git-commit
PORT=8000
TRUSTED_HOSTS=command-center.example.com,localhost,127.0.0.1
ALLOWED_ORIGINS=https://command-center.example.com
LOG_LEVEL=INFO
DEFAULT_BUDGET_USD=2.0
DEFAULT_TOKEN_BUDGET=50000
LLM_MODE=deterministic
# Optional approved provider values. Supply the API key only through a protected file mount.
# LLM_MODE=openai-compatible
# LLM_BASE_URL=https://approved-provider.example/v1
# LLM_MODEL=approved-model
# LLM_API_KEY_FILE=/run/secrets/llm_api_key
