APP_ENV=development
APP_VERSION=3.0.0
BUILD_COMMIT=local
DATABASE_PATH=data/command_center.db
UPLOAD_DIR=data/uploads
BACKUP_DIR=data/backups
AGENT_STEP_DELAY_MS=100
EMBEDDING_DIMENSIONS=192
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=6
DEFAULT_BUDGET_USD=2.0
DEFAULT_TOKEN_BUDGET=50000
MAX_AGENT_RETRIES=2
APPROVAL_RISK_LEVELS=high,critical
AUDIT_HMAC_SECRET_FILE=secrets/audit_hmac_secret
LOG_LEVEL=INFO
JSON_LOGS=true
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
ALLOWED_ORIGINS=
ENFORCE_SECURE_CONFIG=false
LLM_MODE=deterministic
# Optional approved provider:
# LLM_MODE=openai-compatible
# LLM_BASE_URL=https://approved-provider.example/v1
# LLM_API_KEY_FILE=/absolute/path/to/protected/llm_api_key
# LLM_MODEL=approved-model
